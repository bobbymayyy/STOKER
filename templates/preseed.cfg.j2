### {{ project.name }} Debian 13 (Trixie) unattended appliance install
### Generated by stoker-iso-builder {{ builder_version }}
### Build ID: {{ build_id }}
### WARNING: This configuration erases the selected first non-USB fixed disk.

### Installer behavior
d-i auto-install/enable boolean true
d-i debconf/priority select critical
d-i finish-install/reboot_in_progress note

### Locale and console
d-i debian-installer/locale string {{ installer.locale }}
d-i localechooser/supported-locales multiselect {{ installer.locale }}
d-i keyboard-configuration/xkb-keymap select {{ installer.keyboard }}

### Network
d-i netcfg/choose_interface select {{ network.interface }}
d-i netcfg/get_hostname string {{ installer.hostname }}
d-i netcfg/get_domain string {{ installer.domain }}
d-i netcfg/disable_autoconfig boolean false
d-i netcfg/get_ipaddress string
d-i netcfg/get_netmask string
d-i netcfg/get_gateway string
d-i netcfg/get_nameservers string
d-i netcfg/confirm_static boolean true
d-i netcfg/enable boolean true
d-i netcfg/use_autoconfig boolean true
d-i netcfg/wireless_wep string

### Time
d-i clock-setup/utc boolean true
d-i time/zone string {{ installer.timezone }}
d-i clock-setup/ntp boolean true

### Accounts
d-i passwd/root-login boolean {{ (not installer.account.disable_root) | lower }}
d-i passwd/root-password-crypted password !
d-i passwd/make-user boolean true
d-i passwd/user-fullname string {{ installer.account.full_name }}
d-i passwd/username string {{ installer.account.username }}
d-i passwd/user-password-crypted password {{ secrets.user_password_hash }}
d-i passwd/user-default-groups string {{ installer.account.groups | join(' ') }}

### Package source during base installation
d-i apt-setup/use_mirror boolean false
d-i apt-setup/cdrom/set-first boolean true
d-i apt-setup/disable-cdrom-entries boolean false
d-i apt-setup/non-free boolean true
d-i apt-setup/contrib boolean true
d-i apt-setup/services-select multiselect

tasksel tasksel/first multiselect standard
d-i pkgsel/include string {{ installer.installer_packages | join(' ') }}
d-i pkgsel/upgrade select none
d-i pkgsel/update-policy select none
popularity-contest popularity-contest/participate boolean false

### STOKER disk policy
d-i partman/early_command string \
    cp /cdrom/stoker/scripts/select-install-disk.sh /tmp/select-install-disk.sh; \
    chmod 0755 /tmp/select-install-disk.sh; \
    /tmp/select-install-disk.sh \
        --wipe-all-fixed-disks={{ installer.disk.wipe_all_fixed_disks | lower }} \
        --require-uefi={{ installer.disk.require_uefi | lower }}

### GPT/EFI + encrypted LVM
d-i partman-partitioning/choose_label select gpt
d-i partman-partitioning/default_label string gpt
# Disk selection is delegated to select-install-disk.sh, which excludes USB and
# removable media and sets both partman-auto/disk and grub-installer/bootdev.
d-i partman-auto/method string crypto
d-i partman-auto/choose_recipe select {{ installer.disk.recipe }}
d-i partman-auto-lvm/guided_size string {{ installer.disk.guided_size }}
d-i partman-auto-lvm/new_vg_name string {{ installer.disk.volume_group }}
d-i partman-auto-lvm/purge_lvm_from_device boolean true

d-i partman-lvm/device_remove_lvm boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true

d-i partman-md/device_remove_md boolean true
d-i partman-md/confirm boolean true
d-i partman-md/confirm_nooverwrite boolean true

d-i partman-crypto/passphrase password {{ secrets.luks_passphrase }}
d-i partman-crypto/passphrase-again password {{ secrets.luks_passphrase }}
d-i partman-crypto/weak_passphrase boolean true
d-i partman-auto-crypto/erase_disks boolean {{ installer.disk.erase_before_encryption | lower }}
d-i partman-crypto/confirm boolean true
d-i partman-crypto/confirm_nooverwrite boolean true

d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

### Bootloader
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean false
d-i grub-installer/bootdev string default

### Final provisioning
# The local repository is copied into the target and trusted only as a local
# file repository. The package manifest and enabled module scripts are generated
# from YAML by the ISO builder.
d-i preseed/late_command string \
    cp /cdrom/stoker/scripts/install-offline-packages.sh /tmp/install-offline-packages.sh; \
    chmod 0755 /tmp/install-offline-packages.sh; \
    /tmp/install-offline-packages.sh
